# ── Python ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
venv/
.venv/
env/

# ── Secrets (NEVER commit) ──────────────────────────────
.streamlit/secrets.toml
.env
core/.env
*.env

# ── Knowledge cache (auto-generated) ────────────────────
.knowledge_cache/
*.knowledge.db

# ── AI Net Studio local data stores ──────────────────────
# Local accumulated data, not code — must not be committed. Legacy
# (pre-rename) names kept too so an unmigrated existing checkout doesn't
# suddenly start tracking its own local data.
.ai_net_studio_memory.sqlite
.ai_net_studio_rag_chroma/
.ai_net_studio_topology_cache.json
.ai_net_studio_copilot_state.json
.netbrain_memory.sqlite
.netbrain_rag_chroma/
.netbrain_topology_cache.json

# ── Downloaded vendor docs (auto-generated, regenerate via
# core/knowledge/doc_downloader/run.py) — fetched content and its
# manifest, not code. The folder hierarchy itself is kept via .gitkeep,
# and pdf_downloads/README.md (explaining the mechanism) is intentionally
# NOT matched by these patterns.
pdf_downloads/cisco/*/*.md
pdf_downloads/versa/*/*.pdf
pdf_downloads/fortinet/*/*.pdf
pdf_downloads/paloalto/*/*.md
pdf_downloads/rfc/*.txt
pdf_downloads/.manifest.json
